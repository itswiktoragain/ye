[Unit]
Description=Armpaba pre-guest boot manager
After=systemd-user-sessions.service
Conflicts=getty@tty1.service
Before=getty@tty1.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/armpaba/bootmenu.py
Restart=always
RestartSec=2
StandardInput=tty
StandardOutput=tty
StandardError=journal+console
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
